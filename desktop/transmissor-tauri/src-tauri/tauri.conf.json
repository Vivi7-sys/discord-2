{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord 2 Transmissor",
  "version": "0.2.0-alpha.1",
  "identifier": "com.discord2.transmissor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": [
      "desktop"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Discord 2 \u00b7 Transmissor Windows",
        "width": 1120,
        "height": 820,
        "minWidth": 740,
        "minHeight": 600,
        "backgroundColor": "#08090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Compartilhamento de tela privado do Discord 2",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "PortugueseBR"
        ]
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
