# Modelo das variáveis de ambiente. Copie para .env.local e preencha lá.
# Nunca coloque valores reais neste arquivo (ele vai para o Git).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ROOM_INVITE_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostname exato, sem protocolo ou porta; obrigatório em produção.
TURNSTILE_ALLOWED_HOSTNAME=
# Em produção, a transmissão fica bloqueada até habilitar explicitamente.
ENABLE_SHARE_IN_PRODUCTION=false
